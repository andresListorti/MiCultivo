rules_version = '2';

// Toda la app pasa por el backend Express (Admin SDK, que ignora estas reglas).
// El cliente web NUNCA habla directo con Firestore — solo usa Firebase Auth
// para loguearse y después llama a /api/*. Por eso acá se deniega todo acceso
// directo desde el cliente: es la superficie de ataque más chica posible.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
